# EmailJS config for the contact form — see .env.local.example for context.
# Next.js only loads this file for `next build` (production); see
# .env.development for the `next dev` copy of the same values.
#
# These are safe to commit: EmailJS's "public key" is explicitly designed to
# be exposed client-side (it only authorizes sends through the specific
# service/template configured below, and can be domain-restricted in the
# EmailJS dashboard under Account -> Security). Since this is a static
# export, these values are baked into the public JS bundle at build time
# either way — there's no server-side secret to protect here.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_51oea0i
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xngldvi
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=ga2ddD00dIVW8M-4P
